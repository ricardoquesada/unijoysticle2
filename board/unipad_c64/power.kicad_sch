	(text "C64 +5V INPUT PROTECTION & FERRITE PI-FILTER"
		(exclude_from_sim no)
		(at 35.56 35.56 0)
		(effects
			(font
				(size 2.4892 2.4892)
				(thickness 0.4978)
				(bold yes)
			)
			(justify left bottom)
		)
		(uuid "82000001-0000-4000-8000-000000000001")
	)
	(text "ZERO-DROP P-FET IDEAL DIODE + USB VBUS OR-ING\n(Pico 2 W Datasheet Section 3.5, Figure 10, pp. 15-16)\n- When USB is unplugged (VBUS=0V): R3 (+ Pico internal 20k) pulls Q1 Gate to GND,\n  turning Q1 fully ON (Rds_on = 52mOhm, <3mV drop at 45mA).\n- When USB is plugged in (VBUS=5V): Q1 Gate is pulled to 5V, turning Q1 OFF\n  to block back-feeding into C64 +5V while Pico onboard D1 powers VSYS."
		(exclude_from_sim no)
		(at 35.56 114.3 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "82000001-0000-4000-8000-000000000002")
	)
